<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CinnabarSharp.Desktop.ViewModels"
        xmlns:c="using:CinnabarSharp.Desktop.Controls"
        xmlns:conv="using:CinnabarSharp.Desktop.Converters"
        x:Class="CinnabarSharp.Desktop.Views.CurvesWindow"
        x:DataType="vm:CurvesDialogViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <Button Content="Reset" Command="{Binding ResetCommand}" />
                    <c:CompareButton ShowOriginal="{Binding ShowOriginal}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOk" MinWidth="80" HorizontalContentAlignment="Center" IsEnabled="{Binding !Computing}" />
                    <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="80" HorizontalContentAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Margin="20,16,20,20" Spacing="12">
            <TextBlock Classes="dialogTitle" Text="{Binding $parent[Window].Title}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Transfer map:" VerticalAlignment="Center" />
                <ComboBox x:Name="ModeCombo" ItemsSource="{x:Static vm:CurvesDialogViewModel.Modes}" SelectedItem="{Binding Mode}" MinWidth="130">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRgb}">
                    <CheckBox Content="Red" IsChecked="{Binding EditRed}" />
                    <CheckBox Content="Green" IsChecked="{Binding EditGreen}" />
                    <CheckBox Content="Blue" IsChecked="{Binding EditBlue}" />
                </StackPanel>
            </StackPanel>
            <c:CurveEditor x:Name="Editor" Width="320" Height="320" Model="{Binding}" Version="{Binding Version}" />
            <TextBlock Text="Click to add a point, drag to move it, right-click to remove it." FontSize="11" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
            <StackPanel x:Name="ComputingRow" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Computing}">
                <ProgressBar Width="120" IsIndeterminate="True" />
                <TextBlock Text="Computing…" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
