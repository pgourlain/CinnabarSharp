<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests start the real app (CinnabarSharp with the mcp option) and talk to it over stdio. -->
    <ProjectReference Include="..\CinnabarSharp.Desktop\CinnabarSharp.Desktop.csproj" />
    <ProjectReference Include="..\CinnabarSharp.Mcp\CinnabarSharp.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CinnabarSharp.Core.Tests\Data\SampleFiles\sample1.png" Link="Data\sample1.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinnabarSharp.Core.Tests\Data\SampleFiles\sample1.heic" Link="Data\sample1.heic" CopyToOutputDirectory="PreserveNewest" />
    <!-- The script the release workflow runs on each packaged build (see ScriptTests). -->
    <None Include="..\packaging\smoke-test.txt" Link="Data\smoke-test.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
