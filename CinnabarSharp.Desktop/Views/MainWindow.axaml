<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:CinnabarSharp.Desktop.Converters"
        xmlns:vm="using:CinnabarSharp.Desktop.ViewModels"
        xmlns:c="using:CinnabarSharp.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="CinnabarSharp.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.toolbarSeparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource CinnabarBorderBrush}" />
        </Style>
        <!-- Locked toolbox (comic page mode): dimmed, and no tool shown as selected since none applies. -->
        <Style Selector="ListBox.tools:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="ListBox.tools:disabled ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.tools ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.tabs ListBoxItem">
            <Setter Property="Padding" Value="12,4,6,4" />
        </Style>
        <Style Selector="Button.copyColor">
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="WrapPanel.layerButtons > Button">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ListBox#LayersList ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="ListBox.history ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="StackPanel.toolOptions > StackPanel">
            <Setter Property="Spacing" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Same height and centering for every control of the options bar, wrapped in a StackPanel or not. -->
        <Style Selector="StackPanel.toolOptions > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolOptions ComboBox, StackPanel.toolOptions NumericUpDown, StackPanel.toolOptions TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The spinner inside a NumericUpDown has a minimum height of its own: taller than the box, it hides its border. -->
        <Style Selector="StackPanel.toolOptions NumericUpDown /template/ ButtonSpinner">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="32" />
        </Style>
        <!-- The TextBox inside a NumericUpDown has its own padding and minimum height: same box as the ComboBox. -->
        <Style Selector="StackPanel.toolOptions NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolOptions ComboBox">
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolOptions TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swatch">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.closeTab">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- In-window menu for Windows/Linux; on macOS the menu lives in the system menu bar. -->
        <ContentControl x:Name="MenuHost" DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}" />

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="4" IsEnabled="{Binding IsIdle}">
            <StackPanel Classes="toolbar" Orientation="Horizontal" Spacing="2">
                <Button Command="{Binding NewImageCommand}" AutomationProperties.Name="New image" ToolTip.Tip="New image"><c:StrokeIcon Data="M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7" /></Button>
                <Button Command="{Binding OpenCommand}" AutomationProperties.Name="Open" ToolTip.Tip="Open"><c:StrokeIcon Data="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z" /></Button>
                <Button Command="{Binding SaveCommand}" AutomationProperties.Name="Save" ToolTip.Tip="Save"><c:StrokeIcon Data="M5,3 L16,3 L19,6 L19,21 L5,21 Z M8,3 L8,8 L16,8 L16,3 M8,21 L8,14 L16,14 L16,21" /></Button>
                <Border Classes="toolbarSeparator" />
                <Button Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" ToolTip.Tip="Undo"><c:StrokeIcon Data="M9,14 L4,9 L9,4 M4,9 L14,9 A6,6 0 0 1 14,21 L10,21" /></Button>
                <Button Command="{Binding RedoCommand}" AutomationProperties.Name="Redo" ToolTip.Tip="Redo"><c:StrokeIcon Data="M15,14 L20,9 L15,4 M20,9 L10,9 A6,6 0 0 0 10,21 L14,21" /></Button>
                <Border Classes="toolbarSeparator" />
                <Button Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out"><c:StrokeIcon Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M7,10 L13,10" /></Button>
                <TextBlock Text="{Binding ZoomText}" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in"><c:StrokeIcon Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M7,10 L13,10 M10,7 L10,13" /></Button>
                <Button Command="{Binding BestFitCommand}" AutomationProperties.Name="Best fit" ToolTip.Tip="Best fit"><c:StrokeIcon Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" /></Button>
                <Button Content="1:1" Command="{Binding ActualSizeCommand}" ToolTip.Tip="Actual size" />
            </StackPanel>
        </Border>

        <!-- Tool options (Paint.NET shows these under the toolbar) -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="8,0" Height="40" IsEnabled="{Binding IsIdle}">
            <Panel>
            <!-- Page de BD: page and selected-panel options while the page is edited on the canvas -->
            <StackPanel Classes="toolOptions" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsComicMode}">
                <TextBlock Text="Comic page:" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Comic.Layouts}" SelectedItem="{Binding Comic.SelectedLayout}"
                          DisplayMemberBinding="{Binding Name}" AutomationProperties.Name="Layout" Focusable="False" />
                <TextBlock Text="Gutter" />
                <NumericUpDown Value="{Binding Comic.Gutter}" AutomationProperties.Name="Gutter" Minimum="0" Maximum="400" Increment="5"
                               FormatString="0" Width="64" ShowButtonSpinner="False" HorizontalContentAlignment="Right" />
                <TextBlock Text="Border" />
                <NumericUpDown Value="{Binding Comic.BorderWidth}" AutomationProperties.Name="Border width" Minimum="0" Maximum="60" Increment="1"
                               FormatString="0" Width="56" ShowButtonSpinner="False" HorizontalContentAlignment="Right" />
                <ComboBox ItemsSource="{x:Static vm:ComicPageViewModel.Backgrounds}" SelectedItem="{Binding Comic.SelectedBackground}"
                          DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Page background" Focusable="False" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Comic.HasOverlay}">
                    <TextBlock Text="Overlap" />
                    <Slider Minimum="10" Maximum="25" Value="{Binding Comic.OverlapPercent}" Width="80" AutomationProperties.Name="Overlap of the centre panel"
                            ToolTip.Tip="How far the centre photo covers the others (10-25 %)" Focusable="False" />
                </StackPanel>
                <TextBlock Text="{Binding Comic.PanelText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                <ComboBox x:Name="ComicPanelPhoto" ItemsSource="{Binding Comic.PanelChoices}" SelectedItem="{Binding Comic.SelectedPanelChoice}"
                          AutomationProperties.Name="Photo in this panel" MaxWidth="190" Focusable="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComicSourceViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{Binding Thumbnail}" Width="36" Height="24" Stretch="Uniform" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Stretch" IsChecked="{Binding Comic.PanelStretch}" IsEnabled="{Binding Comic.PanelHasPhoto}"
                          AutomationProperties.Name="Stretch the photo in this panel" Focusable="False"
                          ToolTip.Tip="Show the whole photo stretched to the panel (its proportions change) instead of cropping it" />
                <TextBlock Text="Zoom" />
                <Slider Minimum="100" Maximum="400" Value="{Binding Comic.PanelZoom}" Width="90" IsEnabled="{Binding Comic.PanelCanZoom}"
                        AutomationProperties.Name="Zoom in this panel" ToolTip.Tip="Zoom the photo in this panel" Focusable="False" />
                <Button Content="Apply" Command="{Binding ApplyComicCommand}" ToolTip.Tip="Create the page (Enter)" />
                <Button Content="Cancel" Command="{Binding CancelComicCommand}" ToolTip.Tip="Close the page without keeping it (Esc)" />
            </StackPanel>
            <StackPanel Classes="toolOptions" Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsNotComicMode}">
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowSelectionOptions}">
                    <TextBlock Text="Selection mode:" />
                    <ComboBox x:Name="SelectionModeCombo" AutomationProperties.Name="Selection mode" ItemsSource="{x:Static vm:MainViewModel.SelectionModes}"
                              SelectedItem="{Binding SelectionMode}" MinWidth="120"
                              ToolTip.Tip="⌘/Ctrl: union · Alt: exclude · ⌘/Ctrl+Alt: intersect · right-click: exclude">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowBrushOptions}">
                    <TextBlock Text="Brush width:" />
                    <NumericUpDown Value="{Binding BrushWidth}" AutomationProperties.Name="Brush width" Minimum="1" Maximum="500" Increment="1"
                                   FormatString="0" Width="110" />
                    <CheckBox Content="Antialiasing" IsChecked="{Binding Antialiasing}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowHardnessOptions}">
                    <TextBlock Text="Hardness:" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Hardness}" AutomationProperties.Name="Hardness" Width="100" Margin="0,-8" />
                    <TextBlock Text="{Binding Hardness, StringFormat={}{0}%}" MinWidth="36" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowShapeOptions}">
                    <TextBlock Text="Shape:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ShapeKinds}" AutomationProperties.Name="Shape" SelectedItem="{Binding ShapeKind}" MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ShapeStyles}" AutomationProperties.Name="Shape style" SelectedItem="{Binding ShapeStyle}" MinWidth="140"
                              ToolTip.Tip="Outline and fill: outline in the primary color, filled with the secondary color">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowCornerRadiusOptions}">
                    <TextBlock Text="Radius:" />
                    <NumericUpDown Value="{Binding CornerRadius}" AutomationProperties.Name="Corner radius" Minimum="0" Maximum="1000" Increment="1"
                                   FormatString="0" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowGradientOptions}">
                    <TextBlock Text="Gradient:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.GradientKinds}" AutomationProperties.Name="Gradient" SelectedItem="{Binding GradientKind}" MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Transparency mode" IsChecked="{Binding GradientTransparency}"
                              ToolTip.Tip="Fade the layer from opaque to transparent instead of painting colors" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowCropOptions}">
                    <TextBlock Text="Aspect ratio:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.CropAspects}" AutomationProperties.Name="Aspect ratio" SelectedItem="{Binding SelectedCropAspect}"
                              MinWidth="110" Focusable="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MainViewModel+CropAspectOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Crop" Command="{Binding ApplyCropCommand}" ToolTip.Tip="Crop to the frame (Enter)" />
                    <TextBlock Text="Drag a frame; drag inside to move it, a corner to resize. Esc removes it." Foreground="Gray" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTvMode}">
                    <TextBlock Text="TV:" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{x:Static vm:PrepareForTvViewModel.Resolutions}" SelectedItem="{Binding Tv.SelectedResolution}"
                              DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="TV resolution" Focusable="False" />
                    <ComboBox ItemsSource="{x:Static vm:PrepareForTvViewModel.Fits}" SelectedItem="{Binding Tv.SelectedFit}"
                              DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="How the photo fills the screen"
                              IsEnabled="{Binding !Tv.SideBySide}" Focusable="False" />
                    <ComboBox ItemsSource="{x:Static vm:PrepareForTvViewModel.Backgrounds}" SelectedItem="{Binding Tv.SelectedBackground}"
                              DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Borders"
                              IsVisible="{Binding Tv.ShowBackground}" Focusable="False" />
                    <CheckBox Content="Side by side with" IsChecked="{Binding Tv.SideBySide}" IsVisible="{Binding Tv.CanSideBySide}"
                              Focusable="False" />
                    <ComboBox ItemsSource="{Binding Tv.OtherPhotos}" SelectedItem="{Binding Tv.SecondPhoto}"
                              IsVisible="{Binding Tv.SideBySide}" AutomationProperties.Name="Second photo" Focusable="False" MaxWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentViewModel">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Apply" Command="{Binding ApplyTvCommand}" ToolTip.Tip="Create the TV image (Enter)" />
                    <Button Content="Cancel" Command="{Binding CancelTvCommand}" ToolTip.Tip="Leave without changes (Esc)" />
                    <TextBlock x:Name="TvHint" Text="{Binding Tv.Warning}" IsVisible="{Binding Tv.HasWarning}" Foreground="{DynamicResource CinnabarWarningTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip.Tip="{Binding Tv.Warning}" />
                    <TextBlock Text="{Binding Tv.Hint}" Foreground="Gray" IsVisible="{Binding !Tv.HasWarning}"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" ToolTip.Tip="{Binding Tv.Hint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowBubbleOptions}">
                    <TextBlock Text="Bubble:" ToolTip.Tip="Press on the subject, drag to where the bubble goes, then type. Click elsewhere for the next bubble." />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.BubbleStyles}" AutomationProperties.Name="Bubble style" SelectedItem="{Binding BubbleStyle}"
                              MinWidth="100" Focusable="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Radius:" IsVisible="{Binding ShowBubbleRadius}" />
                    <NumericUpDown Value="{Binding CornerRadius}" ToolTip.Tip="Corner radius (pixels). Click it, then use the mouse wheel or ↑/↓ keys" AutomationProperties.Name="Bubble corner radius" Minimum="0" Maximum="1000" Increment="1"
                                   FormatString="0" Width="60" ShowButtonSpinner="False" HorizontalContentAlignment="Right" IsVisible="{Binding ShowBubbleRadius}" />
                    <TextBlock Text="Outline:" />
                    <NumericUpDown Value="{Binding BrushWidth}" AutomationProperties.Name="Bubble outline width" Minimum="1" Maximum="50" Increment="1"
                                   FormatString="0" Width="52" ShowButtonSpinner="False" HorizontalContentAlignment="Right" ToolTip.Tip="Outline width (pixels). Click it, then use the mouse wheel or ↑/↓ keys. Outline and text: primary color; inside: secondary color" />
                    <CheckBox Content="Numbered" IsChecked="{Binding BubbleNumbered}" Focusable="False"
                              ToolTip.Tip="Add a numbered badge (1, 2, 3...) to each new bubble" />
                    <NumericUpDown Value="{Binding BubbleNextNumber}" AutomationProperties.Name="Next bubble number" Minimum="1" Maximum="999" Increment="1"
                                   FormatString="0" Width="56" ShowButtonSpinner="False" HorizontalContentAlignment="Right" IsVisible="{Binding BubbleNumbered}" ToolTip.Tip="Number of the next bubble. Click it, then use the mouse wheel or ↑/↓ keys" />
                    <CheckBox Content="Own layer" IsChecked="{Binding BubbleOwnLayer}" Focusable="False"
                              ToolTip.Tip="Draw bubbles on a &quot;Bubbles&quot; layer at the top (created when needed)" />
                </StackPanel>
                <Border Classes="toolbarSeparator" IsVisible="{Binding ShowBubbleOptions}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowTextOptions}">
                    <TextBlock Text="Font:" />
                    <ComboBox x:Name="FontFamilyCombo" AutomationProperties.Name="Font" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}"
                              Width="180" MaxDropDownHeight="400" Focusable="False" />
                    <NumericUpDown Value="{Binding FontSize}" AutomationProperties.Name="Font size" Minimum="1" Maximum="1000" Increment="1"
                                   FormatString="0" Width="64" ShowButtonSpinner="False" HorizontalContentAlignment="Right" ToolTip.Tip="Font size (pixels). Click it, then use the mouse wheel or ↑/↓ keys" />
                    <ToggleButton Content="B" FontWeight="Bold" AutomationProperties.Name="Bold" IsChecked="{Binding Bold}" ToolTip.Tip="Bold" Focusable="False" />
                    <ToggleButton Content="I" FontStyle="Italic" AutomationProperties.Name="Italic" IsChecked="{Binding Italic}" ToolTip.Tip="Italic" Focusable="False" />
                    <ToggleButton IsChecked="{Binding Underline}" ToolTip.Tip="Underline" Focusable="False" AutomationProperties.Name="Underline">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.TextAlignments}" AutomationProperties.Name="Alignment" SelectedItem="{Binding TextAlignment}" MinWidth="90"
                              ToolTip.Tip="Alignment" Focusable="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Antialiasing" IsChecked="{Binding Antialiasing}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowToleranceOptions}">
                    <TextBlock Text="Tolerance:" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Tolerance}" AutomationProperties.Name="Tolerance" Width="140" Margin="0,-8" />
                    <TextBlock Text="{Binding Tolerance, StringFormat={}{0}%}" MinWidth="36" />
                    <CheckBox Content="Global" IsChecked="{Binding GlobalFill}"
                              ToolTip.Tip="Match colors anywhere, not only connected ones (or hold Shift)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowColorPickerOptions}">
                    <CheckBox Content="Sample merged image" IsChecked="{Binding SampleImage}"
                              ToolTip.Tip="Pick from all visible layers instead of the current layer" />
                </StackPanel>
            </StackPanel>
            </Panel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="8,4"
                BorderBrush="{DynamicResource CinnabarBorderBrush}">
            <Grid ColumnDefinitions="*,Auto,180,140,140,80">
                <TextBlock Grid.Column="0" Text="{Binding StatusToolName}" IsVisible="{Binding IsIdle}" />
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                    <ProgressBar x:Name="BusyBar" Width="140" MinWidth="140" VerticalAlignment="Center"
                                 IsIndeterminate="{Binding BusyIndeterminate}" Value="{Binding BusyProgress}"
                                 AutomationProperties.Name="Progress" />
                    <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="AgentStatusButton" Classes="statusLink" Margin="0,0,16,0" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CinnabarAccentBrush}"
                        Content="{Binding AgentStatusText}" IsVisible="{Binding AllowAgents}"
                        Command="{Binding ShowAgentConnectionCommand}" ToolTip.Tip="How to connect an AI agent"
                        AutomationProperties.Name="AI agents status" />
                <TextBlock Grid.Column="2" Text="{Binding SelectionSizeText}" />
                <TextBlock Grid.Column="3" Text="{Binding CursorPositionText}" />
                <TextBlock Grid.Column="4" Text="{Binding ImageSizeText}" />
                <TextBlock Grid.Column="5" Text="{Binding ZoomText}" TextAlignment="Right" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="Auto,*,4,240" IsEnabled="{Binding IsIdle}">
            <!-- Tools -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="4"
                    BorderBrush="{DynamicResource CinnabarBorderBrush}">
                <ListBox x:Name="ToolsList" Classes="tools" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}"
                         IsEnabled="{Binding IsNotComicMode}"
                         AutomationProperties.Name="Tools"
                         Width="70" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolViewModel">
                            <Viewbox Width="20" Height="20" ToolTip.Tip="{Binding ToolTip}" Opacity="{Binding IconOpacity}"
                                     AutomationProperties.Name="{Binding ToolTip}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Icon}" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                          StrokeDashArray="{Binding IconDashes}" />
                                </Canvas>
                            </Viewbox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Image tabs + canvas -->
            <DockPanel Grid.Column="1">
                <!-- Scrolls horizontally when the tabs don't fit; the active tab is scrolled into view (code-behind). -->
                <ListBox x:Name="TabsList" DockPanel.Dock="Top" Classes="tabs" ItemsSource="{Binding Documents}" AutomationProperties.Name="Open images"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsNotComicMode}"
                         SelectedItem="{Binding ActiveDocument}" Background="Transparent"
                         IsVisible="{Binding HasDocument}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Classes="closeTab" Content="×" ToolTip.Tip="Close"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Close {0}}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Panel Background="{DynamicResource CinnabarWorkspaceBrush}">
                    <ScrollViewer x:Name="CanvasScroller"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <c:CanvasView x:Name="Canvas" AutomationProperties.Name="Image canvas"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                      Document="{Binding ActiveDocument.Document, FallbackValue={x:Null}}"
                                      RenderVersion="{Binding RenderVersion}"
                                      ViewVersion="{Binding ViewVersion}"
                                      SelectionVersion="{Binding SelectionVersion}"
                                      Overlay="{Binding Overlay}"
                                      BrushSize="{Binding BrushOutlineSize}" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" IsVisible="{Binding !HasDocument}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="16" />
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="2" ResizeDirection="Columns" />

            <!-- Panels: Layers, History, Colors -->
            <DockPanel Grid.Column="3">
                <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Classes="panelTitle" Text="Colors" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Panel Width="56" Height="56">
                                <Button Classes="swatch" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{Binding SecondaryBrush}" Command="{Binding PickSecondaryColorCommand}"
                                        AutomationProperties.Name="Secondary color"
                                        ToolTip.Tip="Secondary color (right button) — click to change" />
                                <Button Classes="swatch" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{Binding PrimaryBrush}" Command="{Binding PickPrimaryColorCommand}"
                                        AutomationProperties.Name="Primary color"
                                        ToolTip.Tip="Primary color (left button) — click to change" />
                            </Panel>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <Button Content="Swap" Command="{Binding SwapColorsCommand}"
                                        ToolTip.Tip="Swap primary and secondary colors (X)" />
                                <Button Content="Reset" Command="{Binding ResetColorsCommand}"
                                        ToolTip.Tip="Black and white (D)" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="3" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding PrimaryColorDetails}">
                                <Border Width="10" Height="10" Background="{Binding PrimaryBrush}" BorderBrush="Gray"
                                        BorderThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PrimaryColorHex}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PrimaryColorRgbText}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                <Button Classes="copyColor" ToolTip.Tip="Copy color…" AutomationProperties.Name="Copy primary color">
                                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                        <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas></Viewbox>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ItemsControl ItemsSource="{Binding PrimaryColorFormats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorFormatLine">
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyColorTextCommand}"
                                                                CommandParameter="{Binding Text}" ToolTip.Tip="Copy {Binding Label}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                                                    <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                                </Canvas></Viewbox>
                                                                <TextBlock Text="{Binding Label}" Width="70" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding SecondaryColorDetails}">
                                <Border Width="10" Height="10" Background="{Binding SecondaryBrush}" BorderBrush="Gray"
                                        BorderThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SecondaryColorHex}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SecondaryColorRgbText}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                <Button Classes="copyColor" ToolTip.Tip="Copy color…" AutomationProperties.Name="Copy secondary color">
                                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                        <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas></Viewbox>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ItemsControl ItemsSource="{Binding SecondaryColorFormats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorFormatLine">
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyColorTextCommand}"
                                                                CommandParameter="{Binding Text}" ToolTip.Tip="Copy {Binding Label}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                                                    <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                                </Canvas></Viewbox>
                                                                <TextBlock Text="{Binding Label}" Width="70" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0" Height="160">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="History" />
                        <ListBox x:Name="HistoryList" Classes="history" AutomationProperties.Name="History" ItemsSource="{Binding History}"
                                 SelectedItem="{Binding SelectedHistoryItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                    <TextBlock Text="{Binding Text}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Classes="panel" BorderThickness="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="Layers" />
                        <WrapPanel DockPanel.Dock="Bottom" Classes="layerButtons" Orientation="Horizontal"
                                   ItemSpacing="2" LineSpacing="2" Margin="0,6,0,0">
                            <Button Command="{Binding AddNewLayerCommand}" ToolTip.Tip="Add new layer" AutomationProperties.Name="Add">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding DeleteLayerCommand}" ToolTip.Tip="Delete layer" AutomationProperties.Name="Del">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,20 L16,20 L17,7 M10,11 L10,16 M14,11 L14,16" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding DuplicateLayerCommand}" ToolTip.Tip="Duplicate layer" AutomationProperties.Name="Dup">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding MoveLayerUpCommand}" ToolTip.Tip="Move layer up" AutomationProperties.Name="Up">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M12,19 L12,5 M6,11 L12,5 L18,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding MoveLayerDownCommand}" ToolTip.Tip="Move layer down" AutomationProperties.Name="Down">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M12,5 L12,19 M6,13 L12,19 L18,13" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding MergeLayerDownCommand}" ToolTip.Tip="Merge layer down" AutomationProperties.Name="Merge">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M5,5 L12,12 L19,5 M12,12 L12,16 M6,19 L18,19 M12,16 L8,19 M12,16 L16,19" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding LayerPropertiesCommand}" ToolTip.Tip="Layer properties (F4)" AutomationProperties.Name="Properties">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M4,7 L20,7 M4,12 L20,12 M4,17 L20,17 M9,5 L9,9 M15,10 L15,14 M8,15 L8,19" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                        </WrapPanel>
                        <ListBox x:Name="LayersList" AutomationProperties.Name="Layers" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsVisible}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Show {0}}"
                                                  ToolTip.Tip="Visible" MinWidth="0" />
                                        <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,8,0"
                                                Background="#FFCCCCCC" BorderBrush="Gray" BorderThickness="1">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="Gray"
                                                       IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
