<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:CinnabarSharp.Desktop.Converters"
        xmlns:vm="using:CinnabarSharp.Desktop.ViewModels"
        xmlns:c="using:CinnabarSharp.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="CinnabarSharp.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <!-- 4-pt grid (4, 8, 12, 16, 24, 32): panels pad 12, a panel title sits 8 above its content. -->
        <Style Selector="Border.panel">
            <Setter Property="BorderBrush" Value="{DynamicResource CinnabarBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CinnabarTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="ListBox.history, ListBox#LayersList">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.toolbarSeparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource CinnabarBorderBrush}" />
        </Style>
        <!-- Locked toolbox (comic page mode): dimmed, and no tool shown as selected since none applies. -->
        <Style Selector="ListBox.tools:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="ListBox.tools:disabled ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.tools ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.tabs ListBoxItem">
            <Setter Property="Padding" Value="12,4,8,4" />
            <Setter Property="Foreground" Value="{DynamicResource CinnabarTextSecondaryBrush}" />
        </Style>
        <!-- The active tab: no filled background, an accent line under it and the text at full strength. -->
        <Style Selector="ListBox.tabs ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource CinnabarTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CinnabarAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector="ListBox.tabs ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CinnabarChromeBrush}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CinnabarTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.recentTile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.copyColor">
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="WrapPanel.layerButtons > Button">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ListBox#LayersList ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="TabControl#SvgTabs TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.history ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="StackPanel.toolOptions > StackPanel">
            <Setter Property="Spacing" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Same height and centering for every control of the options bar, wrapped in a StackPanel or not. -->
        <Style Selector="StackPanel.toolOptions > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolOptions ComboBox, StackPanel.toolOptions NumericUpDown, StackPanel.toolOptions TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The spinner inside a NumericUpDown has a minimum height of its own: taller than the box, it hides its border. -->
        <Style Selector="StackPanel.toolOptions NumericUpDown /template/ ButtonSpinner">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="32" />
        </Style>
        <!-- The TextBox inside a NumericUpDown has its own padding and minimum height: same box as the ComboBox. -->
        <Style Selector="StackPanel.toolOptions NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolOptions ComboBox">
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolOptions TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swatch">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.closeTab">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- In-window menu for Windows/Linux; on macOS the menu lives in the system menu bar. -->
        <ContentControl x:Name="MenuHost" DockPanel.Dock="Top" IsEnabled="{Binding IsIdle}" />

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="4" IsEnabled="{Binding IsIdle}">
            <StackPanel Classes="toolbar" Orientation="Horizontal" Spacing="2">
                <Button Command="{Binding NewImageCommand}" AutomationProperties.Name="New image" ToolTip.Tip="New image"><c:StrokeIcon Data="M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7" /></Button>
                <Button Command="{Binding OpenCommand}" AutomationProperties.Name="Open" ToolTip.Tip="Open"><c:StrokeIcon Data="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z" /></Button>
                <Button Command="{Binding SaveCommand}" AutomationProperties.Name="Save" ToolTip.Tip="Save"><c:StrokeIcon Data="M5,3 L16,3 L19,6 L19,21 L5,21 Z M8,3 L8,8 L16,8 L16,3 M8,21 L8,14 L16,14 L16,21" /></Button>
                <Border Classes="toolbarSeparator" />
                <Button Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" ToolTip.Tip="Undo"><c:StrokeIcon Data="M9,14 L4,9 L9,4 M4,9 L14,9 A6,6 0 0 1 14,21 L10,21" /></Button>
                <Button Command="{Binding RedoCommand}" AutomationProperties.Name="Redo" ToolTip.Tip="Redo"><c:StrokeIcon Data="M15,14 L20,9 L15,4 M20,9 L10,9 A6,6 0 0 0 10,21 L14,21" /></Button>
                <Border Classes="toolbarSeparator" />
                <Button Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out"><c:StrokeIcon Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M7,10 L13,10" /></Button>
                <TextBlock Classes="mono" Text="{Binding ZoomText}" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in"><c:StrokeIcon Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M7,10 L13,10 M10,7 L10,13" /></Button>
                <Button Command="{Binding BestFitCommand}" AutomationProperties.Name="Best fit" ToolTip.Tip="Best fit"><c:StrokeIcon Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15" /></Button>
                <Button Content="1:1" Command="{Binding ActualSizeCommand}" ToolTip.Tip="Actual size" />
            </StackPanel>
        </Border>

        <!-- Tool options (Paint.NET shows these under the toolbar) -->
        <!-- A newer release exists (found at startup, after the user agreed to the check). -->
        <Border DockPanel.Dock="Top" Padding="12,6" IsVisible="{Binding HasUpdate}"
                Background="{DynamicResource CinnabarAccentTintBrush}" BorderBrush="{DynamicResource CinnabarBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <Button Content="Download" Command="{Binding OpenUpdatePageCommand}" AutomationProperties.Name="Open the download page" />
                    <Button Content="Skip this version" Command="{Binding SkipUpdateCommand}" AutomationProperties.Name="Skip this version" />
                    <Button Content="Later" Command="{Binding DismissUpdateCommand}" AutomationProperties.Name="Remind me later" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Update available" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Classes="panel" Padding="8,0" Height="40" IsEnabled="{Binding IsIdle}">
            <!-- Scrolls sideways when the options do not fit (a 200 % screen leaves 960 logical pixels). -->
            <ScrollViewer x:Name="OptionsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Panel>
            <!-- Page de BD: page and selected-panel options while the page is edited on the canvas -->
            <StackPanel Classes="toolOptions" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsComicMode}">
                <TextBlock Text="Comic page:" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Comic.Layouts}" SelectedItem="{Binding Comic.SelectedLayout}"
                          DisplayMemberBinding="{Binding Name}" AutomationProperties.Name="Layout" />
                <TextBlock Text="Gutter" />
                <NumericUpDown Value="{Binding Comic.Gutter}" AutomationProperties.Name="Gutter" Minimum="0" Maximum="400" Increment="5"
                               FormatString="0" Width="64" ShowButtonSpinner="False" HorizontalContentAlignment="Right" />
                <TextBlock Text="Border" />
                <NumericUpDown Value="{Binding Comic.BorderWidth}" AutomationProperties.Name="Border width" Minimum="0" Maximum="60" Increment="1"
                               FormatString="0" Width="56" ShowButtonSpinner="False" HorizontalContentAlignment="Right" />
                <ComboBox ItemsSource="{x:Static vm:ComicPageViewModel.Backgrounds}" SelectedItem="{Binding Comic.SelectedBackground}"
                          DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Page background" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Comic.HasOverlay}">
                    <TextBlock Text="Overlap" />
                    <Slider Minimum="10" Maximum="25" Value="{Binding Comic.OverlapPercent}" Width="80" AutomationProperties.Name="Overlap of the centre panel"
                            ToolTip.Tip="How far the centre photo covers the others (10-25 %)" />
                </StackPanel>
                <TextBlock Text="{Binding Comic.PanelText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                <ComboBox x:Name="ComicPanelPhoto" ItemsSource="{Binding Comic.PanelChoices}" SelectedItem="{Binding Comic.SelectedPanelChoice}"
                          AutomationProperties.Name="Photo in this panel" MaxWidth="190">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComicSourceViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{Binding Thumbnail}" Width="36" Height="24" Stretch="Uniform" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Stretch" IsChecked="{Binding Comic.PanelStretch}" IsEnabled="{Binding Comic.PanelHasPhoto}"
                          AutomationProperties.Name="Stretch the photo in this panel"
                          ToolTip.Tip="Show the whole photo stretched to the panel (its proportions change) instead of cropping it" />
                <TextBlock Text="Zoom" />
                <Slider Minimum="100" Maximum="400" Value="{Binding Comic.PanelZoom}" Width="90" IsEnabled="{Binding Comic.PanelCanZoom}"
                        AutomationProperties.Name="Zoom in this panel" ToolTip.Tip="Zoom the photo in this panel" />
                <Button Content="Apply" Command="{Binding ApplyComicCommand}" ToolTip.Tip="Create the page (Enter)" />
                <Button Content="Cancel" Command="{Binding CancelComicCommand}" ToolTip.Tip="Close the page without keeping it (Esc)" />
            </StackPanel>
            <StackPanel Classes="toolOptions" Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsNotComicMode}">
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowSelectionOptions}">
                    <TextBlock Text="Selection mode:" />
                    <ComboBox x:Name="SelectionModeCombo" AutomationProperties.Name="Selection mode" ItemsSource="{x:Static vm:MainViewModel.SelectionModes}"
                              SelectedItem="{Binding SelectionMode}" MinWidth="120"
                              ToolTip.Tip="⌘/Ctrl: union · Alt: exclude · ⌘/Ctrl+Alt: intersect · right-click: exclude">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowBrushOptions}">
                    <TextBlock Text="Brush width:" />
                    <NumericUpDown Value="{Binding BrushWidth}" AutomationProperties.Name="Brush width" Minimum="1" Maximum="500" Increment="1"
                                   FormatString="0" Width="110" />
                    <CheckBox Content="Antialiasing" IsChecked="{Binding Antialiasing}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowHardnessOptions}">
                    <TextBlock Text="Hardness:" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Hardness}" AutomationProperties.Name="Hardness" Width="100" Margin="0,-8" />
                    <TextBlock Text="{Binding Hardness, StringFormat={}{0}%}" MinWidth="36" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowShapeOptions}">
                    <TextBlock Text="Shape:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ShapeKinds}" AutomationProperties.Name="Shape" SelectedItem="{Binding ShapeKind}" MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ShapeStyles}" AutomationProperties.Name="Shape style" SelectedItem="{Binding ShapeStyle}" MinWidth="140"
                              ToolTip.Tip="Outline and fill: outline in the primary color, filled with the secondary color">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowCornerRadiusOptions}">
                    <TextBlock Text="Radius:" />
                    <NumericUpDown Value="{Binding CornerRadius}" AutomationProperties.Name="Corner radius" Minimum="0" Maximum="1000" Increment="1"
                                   FormatString="0" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorSelectOptions}">
                    <CheckBox Content="Snap" IsChecked="{Binding SnapToObjects}" AutomationProperties.Name="Snap to objects"
                              ToolTip.Tip="Snap to the page and to other objects" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorNodeOptions}">
                    <Button Content="Corner" Command="{Binding NodesCornerCommand}" ToolTip.Tip="Corner node" />
                    <Button Content="Smooth" Command="{Binding NodesSmoothCommand}" ToolTip.Tip="Smooth node" />
                    <Button Content="Symmetric" Command="{Binding NodesSymmetricCommand}" ToolTip.Tip="Symmetric node" />
                    <Button Content="Line" Command="{Binding SegmentsToLinesCommand}" ToolTip.Tip="Make selected segments straight" />
                    <Button Content="Curve" Command="{Binding SegmentsToCurvesCommand}" ToolTip.Tip="Make selected segments curves" />
                    <Button Content="Join" Command="{Binding NodesJoinCommand}" ToolTip.Tip="Join the two selected end nodes" />
                    <Button Content="Break" Command="{Binding NodesBreakCommand}" ToolTip.Tip="Break the path at the selected nodes" />
                    <Button Content="To path" Command="{Binding ConvertToPathCommand}" ToolTip.Tip="Convert the shape to a path" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorShapeOptions}">
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.ShapeStyles}" AutomationProperties.Name="Vector shape style" SelectedItem="{Binding ShapeStyle}" MinWidth="140"
                              ToolTip.Tip="Stroke uses the primary color, fill the secondary color">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorRectangleOptions}">
                    <TextBlock Text="Radius:" />
                    <NumericUpDown Value="{Binding VectorCornerRadius}" AutomationProperties.Name="Rectangle corner radius" Minimum="0" Maximum="10000" Increment="1"
                                   FormatString="0" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowLibraryShapeOptions}">
                    <Button x:Name="LibraryShapeButton" AutomationProperties.Name="Choose shape" ToolTip.Tip="Choose the shape to draw">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{Binding CurrentLibraryShape.Icon}" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Viewbox>
                            <TextBlock Text="{Binding CurrentLibraryShape.Name}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Grid ColumnDefinitions="170,Auto" Height="360">
                                    <ListBox ItemsSource="{Binding LibraryCategories}" SelectedItem="{Binding SelectedLibraryCategory}"
                                             AutomationProperties.Name="Shape categories" />
                                    <ScrollViewer Grid.Column="1" Width="420" Margin="8,0,0,0" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding LibraryShapes}" AutomationProperties.Name="Shapes">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryShapeItem">
                                                    <Button Width="60" Height="60" Margin="2" Padding="0" Click="OnLibraryShapeClicked"
                                                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                                        <Viewbox Width="36" Height="36">
                                                            <Path Data="{Binding Icon}" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                                        </Viewbox>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorPolygonOptions}">
                    <TextBlock Text="Corners:" />
                    <NumericUpDown Value="{Binding PolygonCorners}" AutomationProperties.Name="Polygon corners" Minimum="3" Maximum="100" Increment="1" FormatString="0" Width="100" />
                    <TextBlock Text="Star:" />
                    <NumericUpDown Value="{Binding StarRatioPercent}" AutomationProperties.Name="Star ratio" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="100"
                                   ToolTip.Tip="0 draws a polygon; larger values dig the inner corners deeper" />
                    <TextBlock Text="Rounding:" />
                    <NumericUpDown Value="{Binding PolygonRounding}" AutomationProperties.Name="Polygon rounding" Minimum="0" Maximum="1000" Increment="1" FormatString="0" Width="100" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorPencilOptions}">
                    <TextBlock Text="Smoothing:" />
                    <Slider Value="{Binding PencilSmoothing}" AutomationProperties.Name="Pencil smoothing" Minimum="0" Maximum="100" Width="120" />
                    <TextBlock Text="{Binding PencilSmoothing, StringFormat={}{0}%}" MinWidth="36" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowVectorGradientOptions}">
                    <TextBlock Text="Gradient:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.GradientKinds}" AutomationProperties.Name="Vector gradient" SelectedItem="{Binding GradientKind}" MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="On stroke" IsChecked="{Binding GradientOnStroke}" ToolTip.Tip="Paint the stroke instead of the fill" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowGradientOptions}">
                    <TextBlock Text="Gradient:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.GradientKinds}" AutomationProperties.Name="Gradient" SelectedItem="{Binding GradientKind}" MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Transparency mode" IsChecked="{Binding GradientTransparency}"
                              ToolTip.Tip="Fade the layer from opaque to transparent instead of painting colors" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowCropOptions}">
                    <TextBlock Text="Aspect ratio:" />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.CropAspects}" AutomationProperties.Name="Aspect ratio" SelectedItem="{Binding SelectedCropAspect}"
                              MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MainViewModel+CropAspectOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Crop" Command="{Binding ApplyCropCommand}" ToolTip.Tip="Crop to the frame (Enter)" />
                    <TextBlock Text="Drag a frame; drag inside to move it, a corner to resize. Esc removes it." Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTvMode}">
                    <TextBlock Text="TV:" FontWeight="SemiBold" />
                    <ListBox Classes="segmented" ItemsSource="{x:Static vm:PrepareForTvViewModel.Resolutions}" SelectedItem="{Binding Tv.SelectedResolution}"
                             DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="TV resolution" />
                    <ComboBox ItemsSource="{x:Static vm:PrepareForTvViewModel.Fits}" SelectedItem="{Binding Tv.SelectedFit}"
                              DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="How the photo fills the screen"
                              IsEnabled="{Binding !Tv.SideBySide}" />
                    <ComboBox ItemsSource="{x:Static vm:PrepareForTvViewModel.Backgrounds}" SelectedItem="{Binding Tv.SelectedBackground}"
                              DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Borders"
                              IsVisible="{Binding Tv.ShowBackground}" />
                    <CheckBox Content="Side by side with" IsChecked="{Binding Tv.SideBySide}" IsVisible="{Binding Tv.CanSideBySide}"
                              />
                    <ComboBox ItemsSource="{Binding Tv.OtherPhotos}" SelectedItem="{Binding Tv.SecondPhoto}"
                              IsVisible="{Binding Tv.SideBySide}" AutomationProperties.Name="Second photo" MaxWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentViewModel">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Apply" Command="{Binding ApplyTvCommand}" ToolTip.Tip="Create the TV image (Enter)" />
                    <Button Content="Cancel" Command="{Binding CancelTvCommand}" ToolTip.Tip="Leave without changes (Esc)" />
                    <TextBlock x:Name="TvHint" Text="{Binding Tv.Warning}" IsVisible="{Binding Tv.HasWarning}" Foreground="{DynamicResource CinnabarWarningTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip.Tip="{Binding Tv.Warning}" />
                    <TextBlock Text="{Binding Tv.Hint}" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" IsVisible="{Binding !Tv.HasWarning}"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" ToolTip.Tip="{Binding Tv.Hint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowBubbleOptions}">
                    <TextBlock Text="Bubble:" ToolTip.Tip="Press on the subject, drag to where the bubble goes, then type. Click elsewhere for the next bubble." />
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.BubbleStyles}" AutomationProperties.Name="Bubble style" SelectedItem="{Binding BubbleStyle}"
                              MinWidth="100">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Radius:" IsVisible="{Binding ShowBubbleRadius}" />
                    <NumericUpDown Value="{Binding CornerRadius}" ToolTip.Tip="Corner radius (pixels). Click it, then use the mouse wheel or ↑/↓ keys" AutomationProperties.Name="Bubble corner radius" Minimum="0" Maximum="1000" Increment="1"
                                   FormatString="0" Width="60" ShowButtonSpinner="False" HorizontalContentAlignment="Right" IsVisible="{Binding ShowBubbleRadius}" />
                    <TextBlock Text="Outline:" />
                    <NumericUpDown Value="{Binding BrushWidth}" AutomationProperties.Name="Bubble outline width" Minimum="1" Maximum="50" Increment="1"
                                   FormatString="0" Width="52" ShowButtonSpinner="False" HorizontalContentAlignment="Right" ToolTip.Tip="Outline width (pixels). Click it, then use the mouse wheel or ↑/↓ keys. Outline and text: primary color; inside: secondary color" />
                    <CheckBox Content="Numbered" IsChecked="{Binding BubbleNumbered}"
                              ToolTip.Tip="Add a numbered badge (1, 2, 3...) to each new bubble" />
                    <NumericUpDown Value="{Binding BubbleNextNumber}" AutomationProperties.Name="Next bubble number" Minimum="1" Maximum="999" Increment="1"
                                   FormatString="0" Width="56" ShowButtonSpinner="False" HorizontalContentAlignment="Right" IsVisible="{Binding BubbleNumbered}" ToolTip.Tip="Number of the next bubble. Click it, then use the mouse wheel or ↑/↓ keys" />
                    <CheckBox Content="Own layer" IsChecked="{Binding BubbleOwnLayer}"
                              ToolTip.Tip="Draw bubbles on a &quot;Bubbles&quot; layer at the top (created when needed)" />
                </StackPanel>
                <Border Classes="toolbarSeparator" IsVisible="{Binding ShowBubbleOptions}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowTextOptions}">
                    <TextBlock Text="Font:" />
                    <ComboBox x:Name="FontFamilyCombo" AutomationProperties.Name="Font" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}"
                              Width="180" MaxDropDownHeight="400" />
                    <NumericUpDown Value="{Binding FontSize}" AutomationProperties.Name="Font size" Minimum="1" Maximum="1000" Increment="1"
                                   FormatString="0" Width="64" ShowButtonSpinner="False" HorizontalContentAlignment="Right" ToolTip.Tip="Font size (pixels). Click it, then use the mouse wheel or ↑/↓ keys" />
                    <ToggleButton Content="B" FontWeight="Bold" AutomationProperties.Name="Bold" IsChecked="{Binding Bold}" ToolTip.Tip="Bold" />
                    <ToggleButton Content="I" FontStyle="Italic" AutomationProperties.Name="Italic" IsChecked="{Binding Italic}" ToolTip.Tip="Italic" />
                    <ToggleButton IsChecked="{Binding Underline}" ToolTip.Tip="Underline" AutomationProperties.Name="Underline">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                    <ComboBox ItemsSource="{x:Static vm:MainViewModel.TextAlignments}" AutomationProperties.Name="Alignment" SelectedItem="{Binding TextAlignment}" MinWidth="90"
                              ToolTip.Tip="Alignment">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="Antialiasing" IsChecked="{Binding Antialiasing}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowToleranceOptions}">
                    <TextBlock Text="Tolerance:" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Tolerance}" AutomationProperties.Name="Tolerance" Width="140" Margin="0,-8" />
                    <TextBlock Text="{Binding Tolerance, StringFormat={}{0}%}" MinWidth="36" />
                    <CheckBox Content="Global" IsChecked="{Binding GlobalFill}"
                              ToolTip.Tip="Match colors anywhere, not only connected ones (or hold Shift)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowColorPickerOptions}">
                    <CheckBox Content="Sample merged image" IsChecked="{Binding SampleImage}"
                              ToolTip.Tip="Pick from all visible layers instead of the current layer" />
                </StackPanel>
                <Border Classes="toolbarSeparator" IsVisible="{Binding ShowGridOptions}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowGridOptions}">
                    <CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" AutomationProperties.Name="Show grid"
                              ToolTip.Tip="Show a grid over the picture (Ctrl+')" />
                    <CheckBox Content="Snap" IsChecked="{Binding SnapToGrid}" AutomationProperties.Name="Snap to grid"
                              ToolTip.Tip="Drawing tools place points on the grid (Ctrl+;)" />
                    <NumericUpDown Value="{Binding GridSize}" AutomationProperties.Name="Grid size" Minimum="1" Maximum="1000" Increment="1"
                                   FormatString="0.##" Width="72" ShowButtonSpinner="False" HorizontalContentAlignment="Right"
                                   ToolTip.Tip="Distance between grid lines (pixels, or user units in a drawing)" />
                </StackPanel>
            </StackPanel>
            </Panel>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="8,4"
                BorderBrush="{DynamicResource CinnabarBorderBrush}">
            <Grid ColumnDefinitions="*,Auto,180,140,140,80">
                <TextBlock Grid.Column="0" Text="{Binding StatusToolName}" IsVisible="{Binding IsIdle}" />
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                    <ProgressBar x:Name="BusyBar" Width="140" MinWidth="140" VerticalAlignment="Center"
                                 IsIndeterminate="{Binding BusyIndeterminate}" Value="{Binding BusyProgress}"
                                 AutomationProperties.Name="Progress" />
                    <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="AgentStatusButton" Classes="statusLink" Margin="0,0,16,0" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CinnabarAccentBrush}"
                        Content="{Binding AgentStatusText}" IsVisible="{Binding AllowAgents}"
                        Command="{Binding ShowAgentConnectionCommand}" ToolTip.Tip="How to connect an AI agent"
                        AutomationProperties.Name="AI agents status" />
                <TextBlock Grid.Column="2" Text="{Binding SelectionSizeText}" />
                <TextBlock Grid.Column="3" Text="{Binding CursorPositionText}" />
                <TextBlock Grid.Column="4" Text="{Binding ImageSizeText}" />
                <TextBlock Grid.Column="5" Text="{Binding ZoomText}" TextAlignment="Right" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="Auto,*,4,280" IsEnabled="{Binding IsIdle}">
            <!-- Tools -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" Padding="4"
                    BorderBrush="{DynamicResource CinnabarBorderBrush}">
                <ListBox x:Name="ToolsList" Classes="tools" ItemsSource="{Binding ToolboxTools}" SelectedItem="{Binding ToolboxSelection}"
                         IsEnabled="{Binding IsNotComicMode}"
                         AutomationProperties.Name="Tools"
                         Width="70" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolViewModel">
                            <Viewbox Width="20" Height="20" ToolTip.Tip="{Binding ToolTip}" Opacity="{Binding IconOpacity}"
                                     AutomationProperties.Name="{Binding ToolTip}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Icon}" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                          StrokeDashArray="{Binding IconDashes}" />
                                </Canvas>
                            </Viewbox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Image tabs + canvas -->
            <DockPanel Grid.Column="1">
                <!-- Scrolls horizontally when the tabs don't fit; the active tab is scrolled into view (code-behind). -->
                <ListBox x:Name="TabsList" DockPanel.Dock="Top" Classes="tabs" ItemsSource="{Binding Documents}" AutomationProperties.Name="Open images"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsNotComicMode}"
                         SelectedItem="{Binding ActiveDocument}" Background="Transparent"
                         IsVisible="{Binding HasDocument}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Height="18" MinWidth="18" MaxWidth="26" VerticalAlignment="Center" BorderThickness="1" CornerRadius="2"
                                        BorderBrush="{DynamicResource CinnabarBorderBrush}"
                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource CinnabarAccentBrush}" VerticalAlignment="Center"
                                         IsVisible="{Binding IsDirty}" AutomationProperties.Name="Unsaved changes" />
                                <Button Classes="closeTab" Content="×" ToolTip.Tip="Close"
                                        AutomationProperties.Name="{Binding Title, StringFormat=Close {0}}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Panel Background="{DynamicResource CinnabarWorkspaceBrush}">
                    <!-- Rulers (View › Show Rulers) around the canvas; dragging out of one makes a guide. -->
                    <Grid x:Name="CanvasArea" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                        <Border Grid.Row="0" Grid.Column="0" Width="20" Height="20" Background="#EEEBE6" IsVisible="{Binding ShowRulers}" />
                        <c:RulerView x:Name="RulerTop" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowRulers}"
                                     AutomationProperties.Name="Horizontal ruler" ToolTip.Tip="Drag down to make a horizontal guide" />
                        <c:RulerView x:Name="RulerLeft" Grid.Row="1" Grid.Column="0" Orientation="Vertical" IsVisible="{Binding ShowRulers}"
                                     AutomationProperties.Name="Vertical ruler" ToolTip.Tip="Drag right to make a vertical guide" />
                        <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <c:CanvasView x:Name="Canvas" AutomationProperties.Name="Image canvas"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                          Document="{Binding ActiveDocument.ImageOrNull, FallbackValue={x:Null}}"
                                          SvgDocument="{Binding ActiveDocument.SvgOrNull, FallbackValue={x:Null}}"
                                          RenderVersion="{Binding RenderVersion}"
                                          ViewVersion="{Binding ViewVersion}"
                                          SelectionVersion="{Binding SelectionVersion}"
                                          Overlay="{Binding Overlay}" Grid="{Binding Grid}" Guides="{Binding Guides}"
                                          BrushSize="{Binding BrushOutlineSize}" />
                        </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="EmptyHint" IsVisible="{Binding IsEmptyHintVisible}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="16" />
                    <!-- Welcome screen: shown while no image is open (a setting). -->
                    <ScrollViewer x:Name="WelcomePanel" IsVisible="{Binding IsWelcomeVisible}" HorizontalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <Border MaxWidth="980" Margin="24" HorizontalAlignment="Center" CornerRadius="10" ClipToBounds="True"
                                Background="{DynamicResource CinnabarPanelBrush}" BoxShadow="0 20 48 0 #59000000">
                            <Grid ColumnDefinitions="1.5*,1*">
                                <StackPanel Margin="40" Spacing="24">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Image Source="avares://CinnabarSharp/Assets/icon.png" Width="44" Height="44" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CinnabarSharp" FontSize="26" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding VersionText}" FontSize="12"
                                                       Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <WrapPanel ItemSpacing="12" LineSpacing="12">
                                        <Button Content="Open a photo…" Command="{Binding OpenCommand}" IsDefault="True" Height="40" Padding="18,0" />
                                        <Button Content="New image…" Command="{Binding NewImageCommand}" Height="40" Padding="18,0" />
                                        <Button Content="Paste from clipboard" Command="{Binding PasteIntoNewImageCommand}" Height="40" Padding="18,0" />
                                    </WrapPanel>
                                    <StackPanel Spacing="12" IsVisible="{Binding HasRecentItems}">
                                        <TextBlock Classes="sectionTitle" Text="Recent" />
                                        <ItemsControl ItemsSource="{Binding RecentItems}" AutomationProperties.Name="Recent files">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="16" LineSpacing="16" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RecentFileItem">
                                                    <Button Classes="recentTile" Width="104"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentItemCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                                        <StackPanel Spacing="8">
                                                            <Border Height="72" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                                                                    Background="{DynamicResource CinnabarChromeBrush}"
                                                                    BorderBrush="{DynamicResource CinnabarBorderBrush}">
                                                                <Panel>
                                                                    <TextBlock Text="{Binding Extension}" FontSize="12" FontWeight="SemiBold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                           IsVisible="{Binding HasThumbnail}" />
                                                                </Panel>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Border Height="72" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource CinnabarBorderBrush}">
                                        <TextBlock Text="Drop images here to open them" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource CinnabarChromeBrush}" BorderThickness="1,0,0,0"
                                        BorderBrush="{DynamicResource CinnabarBorderBrush}">
                                    <DockPanel Margin="32,40">
                                        <CheckBox DockPanel.Dock="Bottom" Margin="0,16,0,0" IsChecked="{Binding ShowWelcomeScreen}"
                                                  Content="Show this screen when no image is open" />
                                        <StackPanel Spacing="12">
                                            <TextBlock Classes="sectionTitle" Text="Shortcuts" />
                                            <ItemsControl ItemsSource="{x:Static vm:MainViewModel.WelcomeShortcuts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WelcomeShortcut">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                                            <TextBlock Text="{Binding What}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Border Grid.Column="1" Padding="8,2" CornerRadius="4" BorderThickness="1" Margin="12,0,0,0"
                                                                    Background="{DynamicResource CinnabarSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource CinnabarBorderBrush}">
                                                                <TextBlock Text="{Binding Keys}" FontSize="12" Classes="mono" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="2" ResizeDirection="Columns" />

            <!-- Panels: Layers, History, Colors -->
            <!-- Layers get twice the height of History; Colors keep theirs. On a short window (a 200 % screen) both shrink
                 instead of squeezing the layer list to nothing. -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="170" />
                    <RowDefinition Height="*" MinHeight="90" MaxHeight="200" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Classes="panel" BorderThickness="0" IsVisible="{Binding IsNotSvg}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="Layers" />
                        <WrapPanel DockPanel.Dock="Bottom" Classes="layerButtons" Orientation="Horizontal"
                                   ItemSpacing="4" LineSpacing="4" Margin="0,8,0,0">
                            <Button Command="{Binding AddNewLayerCommand}" ToolTip.Tip="Add new layer" AutomationProperties.Name="Add">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding DeleteLayerCommand}" ToolTip.Tip="Delete layer" AutomationProperties.Name="Del">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,20 L16,20 L17,7 M10,11 L10,16 M14,11 L14,16" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding DuplicateLayerCommand}" ToolTip.Tip="Duplicate layer" AutomationProperties.Name="Dup">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding MoveLayerUpCommand}" ToolTip.Tip="Move layer up" AutomationProperties.Name="Up">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M12,19 L12,5 M6,11 L12,5 L18,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding MoveLayerDownCommand}" ToolTip.Tip="Move layer down" AutomationProperties.Name="Down">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M12,5 L12,19 M6,13 L12,19 L18,13" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding MergeLayerDownCommand}" ToolTip.Tip="Merge layer down" AutomationProperties.Name="Merge">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M5,5 L12,12 L19,5 M12,12 L12,16 M6,19 L18,19 M12,16 L8,19 M12,16 L16,19" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                            <Button Command="{Binding LayerPropertiesCommand}" ToolTip.Tip="Layer properties (F4)" AutomationProperties.Name="Properties">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                    <Path Data="M4,7 L20,7 M4,12 L20,12 M4,17 L20,17 M9,5 L9,9 M15,10 L15,14 M8,15 L8,19" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas></Viewbox>
                            </Button>
                        </WrapPanel>
                        <ListBox x:Name="LayersList" AutomationProperties.Name="Layers" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsVisible}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Show {0}}"
                                                  ToolTip.Tip="Visible" MinWidth="0" />
                                        <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,8,0"
                                                Background="#FFCCCCCC" BorderBrush="Gray" BorderThickness="1">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource CinnabarTextSecondaryBrush}"
                                                       IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <!-- SVG drawings: Objects and Properties instead of Layers. -->
                <Border Grid.Row="0" Classes="panel" BorderThickness="0" IsVisible="{Binding HasSvg}">
                    <TabControl x:Name="SvgTabs" Padding="0">
                        <TabItem Header="Objects" AutomationProperties.Name="Objects tab">
                            <DockPanel Margin="0,8,0,0">
                                <WrapPanel DockPanel.Dock="Bottom" Classes="layerButtons" Orientation="Horizontal"
                                           ItemSpacing="4" LineSpacing="4" Margin="0,8,0,0">
                                    <Button Command="{Binding DuplicateObjectsCommand}" ToolTip.Tip="Duplicate (Ctrl+D)" AutomationProperties.Name="Duplicate objects"><c:StrokeIcon Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Size="16" /></Button>
                                    <Button Command="{Binding DeleteObjectsCommand}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete objects"><c:StrokeIcon Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,20 L16,20 L17,7 M10,11 L10,16 M14,11 L14,16" Size="16" /></Button>
                                    <Button Command="{Binding GroupObjectsCommand}" ToolTip.Tip="Group (Ctrl+G)" AutomationProperties.Name="Group objects"><c:StrokeIcon Data="M3,3 L21,3 L21,21 L3,21 Z M7,7 L12,7 L12,12 L7,12 Z M12,12 L17,12 L17,17 L12,17 Z" Size="16" /></Button>
                                    <Button Command="{Binding UngroupObjectsCommand}" ToolTip.Tip="Ungroup (Ctrl+Shift+G)" AutomationProperties.Name="Ungroup objects"><c:StrokeIcon Data="M4,4 L11,4 L11,11 L4,11 Z M13,13 L20,13 L20,20 L13,20 Z" Size="16" /></Button>
                                    <Button Command="{Binding RaiseObjectsCommand}" ToolTip.Tip="Raise" AutomationProperties.Name="Raise objects"><c:StrokeIcon Data="M12,19 L12,7 M6,12 L12,6 L18,12 M6,3 L18,3" Size="16" /></Button>
                                    <Button Command="{Binding LowerObjectsCommand}" ToolTip.Tip="Lower" AutomationProperties.Name="Lower objects"><c:StrokeIcon Data="M12,5 L12,17 M6,12 L12,18 L18,12 M6,21 L18,21" Size="16" /></Button>
                                </WrapPanel>
                                <ListBox x:Name="ObjectsList" Classes="objects" AutomationProperties.Name="Objects" ItemsSource="{Binding Objects}"
                                         SelectionMode="Multiple,Toggle" DragDrop.AllowDrop="True">
                                    <ListBox.Styles>
                                        <Style Selector="ListBox.objects ListBoxItem" x:DataType="vm:ObjectViewModel">
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <Setter Property="Padding" Value="4,2" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ObjectViewModel">
                                            <DockPanel Margin="{Binding Indent}" DoubleTapped="OnObjectDoubleTapped">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsVisible}" MinWidth="0" Padding="0"
                                                          AutomationProperties.Name="{Binding Name, StringFormat=Show {0}}" ToolTip.Tip="Visible" />
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsLocked}" MinWidth="0" Padding="0"
                                                          AutomationProperties.Name="{Binding Name, StringFormat=Lock {0}}" ToolTip.Tip="Locked" Content="L" FontSize="9" />
                                                <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded}" Width="16" Height="16" Padding="0"
                                                              Background="Transparent" BorderThickness="0" IsVisible="{Binding HasChildren}"
                                                              AutomationProperties.Name="{Binding Name, StringFormat=Expand {0}}" Content="▸" FontSize="10" />
                                                <Panel DockPanel.Dock="Left" Width="16" IsVisible="{Binding !HasChildren}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsEditing}" />
                                                    <TextBox Text="{Binding EditText}" IsVisible="{Binding IsEditing}" MinHeight="0" Padding="4,2"
                                                             AutomationProperties.Name="Object name" KeyDown="OnObjectNameKeyDown" LostFocus="OnObjectNameLostFocus" />
                                                    <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Properties" AutomationProperties.Name="Properties tab">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,8,8,8" Spacing="12" DataContext="{Binding Properties}" x:DataType="vm:SvgPropertiesViewModel">
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                    <StackPanel Spacing="6" IsEnabled="{Binding HasSelection}">
                                        <TextBlock Classes="sectionTitle" Text="Fill" />
                                        <ComboBox ItemsSource="{x:Static vm:PaintEditor.Modes}" SelectedItem="{Binding Fill.Mode}" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Fill type" />
                                        <Button Command="{Binding Fill.PickColorCommand}" IsVisible="{Binding Fill.IsFlat}" Background="{Binding Fill.Brush}"
                                                Height="26" HorizontalAlignment="Stretch" AutomationProperties.Name="Fill color" ToolTip.Tip="Fill color" />
                                        <StackPanel IsVisible="{Binding Fill.IsGradient}" Spacing="4" x:Name="FillGradient">
                                            <ListBox ItemsSource="{Binding Fill.Stops}" SelectedItem="{Binding Fill.SelectedStop}" AutomationProperties.Name="Fill gradient stops" MaxHeight="120">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GradientStopViewModel">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Command="{Binding PickColorCommand}" Background="{Binding Brush}" Width="32" Height="22"
                                                                    AutomationProperties.Name="Stop color" />
                                                            <Slider Minimum="0" Maximum="1" Value="{Binding Offset}" AutomationProperties.Name="Stop position" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="Add stop" Command="{Binding Fill.AddStopCommand}" />
                                                <Button Content="Remove stop" Command="{Binding Fill.RemoveStopCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding Fill.HasPaint}">
                                            <TextBlock Text="{Binding Fill.Opacity, StringFormat=Opacity {0:0}%}" FontSize="11" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Fill.Opacity}" AutomationProperties.Name="Fill opacity" PointerCaptureLost="OnSliderGestureEnd" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="6" IsEnabled="{Binding HasSelection}">
                                        <TextBlock Classes="sectionTitle" Text="Stroke" />
                                        <ComboBox ItemsSource="{x:Static vm:PaintEditor.Modes}" SelectedItem="{Binding Stroke.Mode}" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Stroke type" />
                                        <Button Command="{Binding Stroke.PickColorCommand}" IsVisible="{Binding Stroke.IsFlat}" Background="{Binding Stroke.Brush}"
                                                Height="26" HorizontalAlignment="Stretch" AutomationProperties.Name="Stroke color" ToolTip.Tip="Stroke color" />
                                        <StackPanel IsVisible="{Binding Stroke.IsGradient}" Spacing="4">
                                            <ListBox ItemsSource="{Binding Stroke.Stops}" SelectedItem="{Binding Stroke.SelectedStop}" AutomationProperties.Name="Stroke gradient stops" MaxHeight="120">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GradientStopViewModel">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Command="{Binding PickColorCommand}" Background="{Binding Brush}" Width="32" Height="22"
                                                                    AutomationProperties.Name="Stop color" />
                                                            <Slider Minimum="0" Maximum="1" Value="{Binding Offset}" AutomationProperties.Name="Stop position" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="Add stop" Command="{Binding Stroke.AddStopCommand}" />
                                                <Button Content="Remove stop" Command="{Binding Stroke.RemoveStopCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding Stroke.HasPaint}" Spacing="6">
                                            <TextBlock Text="{Binding Stroke.Opacity, StringFormat=Opacity {0:0}%}" FontSize="11" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Stroke.Opacity}" AutomationProperties.Name="Stroke opacity" PointerCaptureLost="OnSliderGestureEnd" />
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                <TextBlock Text="Width" VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding StrokeWidth}" Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.##"
                                                               AutomationProperties.Name="Stroke width" />
                                                <TextBlock Grid.Row="1" Text="Cap" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SvgPropertiesViewModel.Caps}" SelectedItem="{Binding Cap}"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Line cap" />
                                                <TextBlock Grid.Row="2" Text="Join" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SvgPropertiesViewModel.Joins}" SelectedItem="{Binding Join}"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Line join" />
                                                <TextBlock Grid.Row="3" Text="Dashes" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:SvgPropertiesViewModel.DashPresets}" SelectedItem="{Binding SelectedDash}"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Dashes">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SvgPropertiesViewModel+DashPreset">
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="4" IsEnabled="{Binding HasSelection}">
                                        <TextBlock Classes="sectionTitle" Text="Object" />
                                        <TextBlock Text="{Binding ObjectOpacity, StringFormat=Opacity {0:0}%}" FontSize="11" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" />
                                        <Slider Minimum="0" Maximum="100" Value="{Binding ObjectOpacity}" AutomationProperties.Name="Object opacity" PointerCaptureLost="OnSliderGestureEnd" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Text="X" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding X}" Increment="1" FormatString="0.###" AutomationProperties.Name="X" />
                                            <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="3" Value="{Binding Y}" Increment="1" FormatString="0.###" AutomationProperties.Name="Y" />
                                            <TextBlock Grid.Row="1" Text="W" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Width}" Minimum="0.001" Increment="1" FormatString="0.###" AutomationProperties.Name="Width" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="H" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Height}" Minimum="0.001" Increment="1" FormatString="0.###" AutomationProperties.Name="Height" />
                                            <TextBlock Grid.Row="2" Text="Rotation" VerticalAlignment="Center" Grid.ColumnSpan="2" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="60,0,0,0" Value="{Binding Rotation}" Increment="5" FormatString="0.##" AutomationProperties.Name="Rotation" />
                                        </Grid>
                                    </StackPanel>
                                    <Expander Header="XML" AutomationProperties.Name="XML of the object" IsEnabled="{Binding HasSelection}">
                                        <TextBox Text="{Binding XmlText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 FontFamily="Menlo,Consolas,monospace" FontSize="11" MaxHeight="220"
                                                 AutomationProperties.Name="XML of the selected object" />
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
                <Border Grid.Row="1" Classes="panel" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="History" />
                        <ListBox x:Name="HistoryList" Classes="history" AutomationProperties.Name="History" ItemsSource="{Binding History}"
                                 SelectedItem="{Binding SelectedHistoryItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                    <TextBlock Text="{Binding Text}" Opacity="{Binding Opacity}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Classes="panelTitle" Text="Colors" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Panel Width="56" Height="56">
                                <Button Classes="swatch" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{Binding SecondaryBrush}" Command="{Binding PickSecondaryColorCommand}"
                                        AutomationProperties.Name="Secondary color"
                                        ToolTip.Tip="Secondary color (right button) — click to change" />
                                <Button Classes="swatch" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{Binding PrimaryBrush}" Command="{Binding PickPrimaryColorCommand}"
                                        AutomationProperties.Name="Primary color"
                                        ToolTip.Tip="Primary color (left button) — click to change" />
                            </Panel>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <Button Content="Swap" Command="{Binding SwapColorsCommand}"
                                        ToolTip.Tip="Swap primary and secondary colors (X)" />
                                <Button Content="Reset" Command="{Binding ResetColorsCommand}"
                                        ToolTip.Tip="Black and white (D)" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding PrimaryColorDetails}">
                                <Border Width="10" Height="10" Background="{Binding PrimaryBrush}" BorderBrush="Gray"
                                        BorderThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PrimaryColorHex}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PrimaryColorRgbText}" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                <Button Classes="copyColor" ToolTip.Tip="Copy color…" AutomationProperties.Name="Copy primary color">
                                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                        <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas></Viewbox>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ItemsControl ItemsSource="{Binding PrimaryColorFormats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorFormatLine">
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyColorTextCommand}"
                                                                CommandParameter="{Binding Text}" ToolTip.Tip="Copy {Binding Label}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                                                    <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                                </Canvas></Viewbox>
                                                                <TextBlock Text="{Binding Label}" Width="70" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding SecondaryColorDetails}">
                                <Border Width="10" Height="10" Background="{Binding SecondaryBrush}" BorderBrush="Gray"
                                        BorderThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SecondaryColorHex}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SecondaryColorRgbText}" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                <Button Classes="copyColor" ToolTip.Tip="Copy color…" AutomationProperties.Name="Copy secondary color">
                                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                        <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas></Viewbox>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ItemsControl ItemsSource="{Binding SecondaryColorFormats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorFormatLine">
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopyColorTextCommand}"
                                                                CommandParameter="{Binding Text}" ToolTip.Tip="Copy {Binding Label}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24">
                                                                    <Path Data="M8,8 L19,8 L19,19 L8,19 Z M5,15 L5,5 L15,5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                                </Canvas></Viewbox>
                                                                <TextBlock Text="{Binding Label}" Width="70" Foreground="{DynamicResource CinnabarTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
