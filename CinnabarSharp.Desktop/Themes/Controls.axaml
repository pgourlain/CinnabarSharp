<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keyboard focus: a 2 px accent ring (the accent has 5:1 contrast on every panel) on whatever has it. -->
    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource CinnabarAccentBrush}" BorderThickness="2" CornerRadius="4" Margin="-1" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- Cinnabar type (tasks.md, Phase 12): IBM Plex Sans at 13 px everywhere, Plex Mono for numbers. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource CinnabarSansFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource CinnabarMonoFont}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource CinnabarMonoFont}" />
    </Style>

    <!-- Cinnabar controls (tasks.md, Phase 12): one 32 px height for edit boxes, in dialogs and in the bars. -->
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The spinner and the TextBox inside have a minimum height of their own: taller than the box, they hide its border. -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Selected text: a light accent tint with the normal text color (the accent itself made it unreadable). -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource CinnabarAccentTintBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource CinnabarTextBrush}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- The primary button is the dialog's default one (OK, Save…): filled with the accent. -->
    <Style Selector="Button[IsDefault=True]">
        <Setter Property="Background" Value="{DynamicResource CinnabarAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button[IsDefault=True]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CinnabarAccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarOnAccentBrush}" />
    </Style>
    <Style Selector="Button[IsDefault=True]:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CinnabarAccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarOnAccentBrush}" />
    </Style>
    <Style Selector="Button[IsDefault=True]:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CinnabarBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarTextSecondaryBrush}" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CinnabarTextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarChromeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- Dialogs: the title in the body, the buttons in a footer band. -->
    <Style Selector="TextBlock.dialogTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.dialogFooter">
        <Setter Property="Background" Value="{DynamicResource CinnabarChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CinnabarBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="20,14" />
    </Style>

    <!-- Segmented control: a ListBox with a few short choices in one row, the chosen one raised (resolutions…). -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource CinnabarChromeBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarTextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CinnabarTextBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CinnabarSurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
